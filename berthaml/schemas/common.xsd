<?xml version="1.0" encoding="UTF-8"?>
<!--
  BerthaML common types.
  Shared by every BerthaML module. Contains identifier formats, date types,
  controlled vocabularies that are genuinely closed (instruments, modes,
  set kinds, transitions), and the record/provenance block.

  Open-ended data (people, songs, venues, releases) is NOT enumerated here.
  It lives in registry files and is cross-checked by tools/validate.py,
  because XSD 1.0 cannot check references between documents.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:b="urn:berthaml:1"
           targetNamespace="urn:berthaml:1"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           version="1.1">

  <!-- ============================================================
       Identifiers
       Registry IDs are xs:ID restrictions (unique within their file).
       References from other files are xs:token restrictions with the
       same pattern; validate.py resolves them.
       ============================================================ -->

  <xs:simpleType name="PersonId">
    <xs:restriction base="xs:ID">
      <xs:pattern value="p-[a-z0-9]+(-[a-z0-9]+)*"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="PersonRef">
    <xs:restriction base="xs:token">
      <xs:pattern value="p-[a-z0-9]+(-[a-z0-9]+)*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SongId">
    <xs:restriction base="xs:ID">
      <xs:pattern value="s-[a-z0-9]+(-[a-z0-9]+)*"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="SongRef">
    <xs:restriction base="xs:token">
      <xs:pattern value="s-[a-z0-9]+(-[a-z0-9]+)*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="VenueId">
    <xs:restriction base="xs:ID">
      <xs:pattern value="v-[a-z0-9]+(-[a-z0-9]+)*"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="VenueRef">
    <xs:restriction base="xs:token">
      <xs:pattern value="v-[a-z0-9]+(-[a-z0-9]+)*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ReleaseId">
    <xs:restriction base="xs:ID">
      <xs:pattern value="rel-[a-z0-9]+(-[a-z0-9]+)*"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ReleaseRef">
    <xs:restriction base="xs:token">
      <xs:pattern value="rel-[a-z0-9]+(-[a-z0-9]+)*"/>
    </xs:restriction>
  </xs:simpleType>

  <!--
    Show IDs: gd + date + optional suffix for multiple shows on one day.
    Unknown month or day is written as xx: gd1966-xx-xx, gd1967-03-xx-late.
    validate.py checks that the ID agrees with show/@date.
  -->
  <xs:simpleType name="ShowId">
    <xs:restriction base="xs:ID">
      <xs:pattern value="gd(19[6-9][0-9])-([0-9]{2}|xx)-([0-9]{2}|xx)(-[a-z0-9]+)?"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ShowRef">
    <xs:restriction base="xs:token">
      <xs:pattern value="gd(19[6-9][0-9])-([0-9]{2}|xx)-([0-9]{2}|xx)(-[a-z0-9]+)?"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Two-letter ISO 3166-1 alpha-2 country code. -->
  <xs:simpleType name="CountryCode">
    <xs:restriction base="xs:token">
      <xs:pattern value="[A-Z]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ============================================================
       Dates
       FuzzyDate allows year, year-month, or full date, because some
       facts (early shows, membership start dates) are only known to
       the month or year.
       ============================================================ -->

  <xs:simpleType name="FuzzyDate">
    <xs:union memberTypes="xs:date xs:gYearMonth xs:gYear"/>
  </xs:simpleType>

  <!-- Show dates: same as FuzzyDate but limited to the Jerry era,
       1965-05-05 (first Warlocks show) to 1995-07-09 (Soldier Field). -->
  <xs:simpleType name="EraDay">
    <xs:restriction base="xs:date">
      <xs:minInclusive value="1965-05-05"/>
      <xs:maxInclusive value="1995-07-09"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="EraMonth">
    <xs:restriction base="xs:gYearMonth">
      <xs:minInclusive value="1965-05"/>
      <xs:maxInclusive value="1995-07"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="EraYear">
    <xs:restriction base="xs:gYear">
      <xs:minInclusive value="1965"/>
      <xs:maxInclusive value="1995"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="EraDate">
    <xs:union memberTypes="b:EraDay b:EraMonth b:EraYear"/>
  </xs:simpleType>

  <!-- Durations: ISO 8601 (PT13M56S), never negative. -->
  <xs:simpleType name="Duration">
    <xs:restriction base="xs:duration">
      <xs:pattern value="PT([0-9]+H)?([0-9]+M)?([0-9]+(\.[0-9]+)?S)?"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ============================================================
       Certainty and record status
       ============================================================ -->

  <!-- Attached to individual facts. Absent means the fact is asserted
       without qualification. -->
  <xs:simpleType name="Certainty">
    <xs:restriction base="xs:token">
      <xs:enumeration value="certain"/>
      <xs:enumeration value="probable"/>
      <xs:enumeration value="uncertain"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Workflow state of a whole file. -->
  <xs:simpleType name="RecordStatus">
    <xs:restriction base="xs:token">
      <!-- generated from registries, not yet researched -->
      <xs:enumeration value="skeleton"/>
      <!-- partly researched, may contain errors -->
      <xs:enumeration value="draft"/>
      <!-- checked by a person against at least one cited source -->
      <xs:enumeration value="reviewed"/>
      <!-- checked against multiple independent sources -->
      <xs:enumeration value="verified"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="Citation">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="title" type="xs:string" use="required"/>
        <xs:attribute name="href" type="xs:anyURI"/>
        <xs:attribute name="accessed" type="xs:date"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="Record">
    <xs:sequence>
      <xs:element name="cite" type="b:Citation" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="status" type="b:RecordStatus" use="required"/>
    <xs:attribute name="updated" type="xs:date"/>
  </xs:complexType>

  <!-- A bare reference to a person, used for lead vocals, removals and defaults. -->
  <xs:complexType name="PersonOnly">
    <xs:attribute name="person" type="b:PersonRef" use="required"/>
    <xs:attribute name="certainty" type="b:Certainty"/>
  </xs:complexType>

  <xs:complexType name="Note">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="certainty" type="b:Certainty"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- How much of a program or recording is known or present. "none" means nothing is listed. -->
  <xs:simpleType name="Coverage">
    <xs:restriction base="xs:token">
      <xs:enumeration value="complete"/>
      <xs:enumeration value="partial"/>
      <xs:enumeration value="none"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Performance and event IDs in one show file, referred to from another document. -->
  <xs:simpleType name="LocalIdList">
    <xs:restriction>
      <xs:simpleType>
        <xs:list itemType="xs:NCName"/>
      </xs:simpleType>
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Candidate links are machine proposals, not curated performance mappings. -->
  <xs:simpleType name="MappingStatus">
    <xs:restriction base="xs:token">
      <xs:enumeration value="unreviewed"/>
      <xs:enumeration value="candidate"/>
      <xs:enumeration value="reviewed"/>
      <xs:enumeration value="not-applicable"/>
      <!-- Researched mapping remains unknown; the record cites that research. -->
      <xs:enumeration value="unknown"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ============================================================
       Closed vocabularies
       ============================================================ -->

  <!--
    Physical instruments only. Roles such as "lead" or "rhythm" are not
    instruments; lead vocals are recorded per performance with <lead>.
    Add values here when a real case needs one; use "other" with
    @detail meanwhile.
  -->
  <xs:simpleType name="InstrumentName">
    <xs:restriction base="xs:token">
      <xs:enumeration value="electric-guitar"/>
      <xs:enumeration value="acoustic-guitar"/>
      <xs:enumeration value="twelve-string-guitar"/>
      <xs:enumeration value="slide-guitar"/>
      <xs:enumeration value="pedal-steel-guitar"/>
      <xs:enumeration value="guitar-synthesizer"/>
      <xs:enumeration value="banjo"/>
      <xs:enumeration value="mandolin"/>
      <xs:enumeration value="fiddle"/>
      <xs:enumeration value="electric-bass"/>
      <xs:enumeration value="acoustic-bass"/>
      <xs:enumeration value="organ"/>
      <xs:enumeration value="piano"/>
      <xs:enumeration value="electric-piano"/>
      <xs:enumeration value="synthesizer"/>
      <xs:enumeration value="harpsichord"/>
      <xs:enumeration value="accordion"/>
      <xs:enumeration value="harmonica"/>
      <xs:enumeration value="drums"/>
      <xs:enumeration value="percussion"/>
      <xs:enumeration value="the-beam"/>
      <xs:enumeration value="saxophone"/>
      <xs:enumeration value="trumpet"/>
      <xs:enumeration value="trombone"/>
      <xs:enumeration value="flute"/>
      <xs:enumeration value="vocals"/>
      <xs:enumeration value="other"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="Instrument">
    <xs:simpleContent>
      <xs:extension base="b:InstrumentName">
        <!-- free text, e.g. a specific model, or what "other" means -->
        <xs:attribute name="detail" type="xs:string"/>
        <xs:attribute name="certainty" type="b:Certainty"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- Set-level mode. "mixed" requires every performance to state its own. -->
  <xs:simpleType name="SetMode">
    <xs:restriction base="xs:token">
      <xs:enumeration value="unknown"/>
      <xs:enumeration value="electric"/>
      <xs:enumeration value="acoustic"/>
      <xs:enumeration value="mixed"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Performance-level mode. Absent means inherit from the set. -->
  <xs:simpleType name="PerformanceMode">
    <xs:restriction base="xs:token">
      <xs:enumeration value="electric"/>
      <xs:enumeration value="acoustic"/>
      <xs:enumeration value="a-cappella"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SetKind">
    <xs:restriction base="xs:token">
      <xs:enumeration value="unknown"/>
      <xs:enumeration value="soundcheck"/>
      <xs:enumeration value="set"/>
      <xs:enumeration value="encore"/>
      <!-- anything else: jam with another act, broadcast-only segment -->
      <xs:enumeration value="other"/>
    </xs:restriction>
  </xs:simpleType>

  <!--
    How a performance ends relative to the next one. This is a fact about
    the performance, not about any tape. A tape cut is recorded on the
    recording, not here; if a cut hides the transition, use "unknown".
  -->
  <xs:simpleType name="Transition">
    <xs:restriction base="xs:token">
      <!-- music continues into the next item without a break -->
      <xs:enumeration value="segue"/>
      <!-- the music stops -->
      <xs:enumeration value="stop"/>
      <xs:enumeration value="unknown"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Completeness">
    <xs:restriction base="xs:token">
      <xs:enumeration value="complete"/>
      <!-- performed only in part, e.g. a verse dropped or a song cut short on stage -->
      <xs:enumeration value="incomplete"/>
      <!-- started and abandoned -->
      <xs:enumeration value="aborted"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
