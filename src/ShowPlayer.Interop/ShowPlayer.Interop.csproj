<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jupiter.ShowPlayer.Interop</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="$(RepoRoot)proto\show_player.proto" ProtoRoot="$(RepoRoot)proto" GrpcServices="None" Access="Public" Link="proto\show_player.proto" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ShowPlayer.BindingCheck" />
  </ItemGroup>
</Project>
