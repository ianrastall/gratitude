<Window x:Class="Jupiter.ShowPlayer.App.WorkshopWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Jupiter.ShowPlayer.App"
    Title="Show workshop - Gratitude">
    <Grid x:Name="Root" Background="{ThemeResource JupiterWindowBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <local:RecordingPrioritiesControl x:Name="PrioritiesControl" HorizontalAlignment="Right" Margin="16,4"/>
        <NavigationView Grid.Row="1" x:Name="Navigation" PaneDisplayMode="Left" OpenPaneLength="224" CompactPaneLength="48" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" SelectionChanged="OnNavigation">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Import a show" Tag="import" Icon="OpenFile" />
                <NavigationViewItem Content="MKA job" Tag="job" Icon="Save" />
            </NavigationView.MenuItems>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <InfoBar x:Name="Notice" Margin="16,8" IsOpen="False" IsClosable="True" />
                <Grid x:Name="ImportPage" Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="400"/><ColumnDefinition Width="320" MinWidth="240"/></Grid.ColumnDefinitions>
                    <Grid Padding="16" RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Show files" Style="{StaticResource JupiterPaneHeadingTextStyle}"/>
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="FolderBox" Header="Show folder" IsReadOnly="True" TextWrapping="Wrap"/>
                                <Button x:Name="ImportButton" Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="OnImport"/>
                            </Grid>
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="NotesPathBox" Header="Show TXT" IsReadOnly="True" TextWrapping="Wrap"/>
                                <Button x:Name="NotesButton" Grid.Column="1" Content="Choose TXT…" VerticalAlignment="Bottom" Click="OnChooseNotes" IsEnabled="False"/>
                            </Grid>
                        </StackPanel>
                        <TextBlock x:Name="ImportSummary" Grid.Row="1" Text="Choose a folder containing one recording and its notes." Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="ImportProgress" Grid.Row="2" IsIndeterminate="True" Visibility="Collapsed"/>
                        <ListView x:Name="TracksList" Grid.Row="3" SelectionChanged="OnTrackSelected" AutomationProperties.Name="Audio files in playback order">
                            <ListView.ItemTemplate><DataTemplate x:DataType="local:ImportTrackRow">
                                <StackPanel Spacing="4" Padding="0,4">
                                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource JupiterBodyTextStyle}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate></ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="4" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Move up" Click="OnMoveUp"/><Button Content="Move down" Click="OnMoveDown"/></StackPanel>
                            <TextBox x:Name="TrackTitleBox" Header="Selected song title" TextChanged="OnTrackEdited" LostFocus="OnTrackEditFinished" IsEnabled="False"/>
                            <TextBox x:Name="TrackSetBox" Header="Selected set or encore" TextChanged="OnTrackEdited" LostFocus="OnTrackEditFinished" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Column="1" Background="{ThemeResource JupiterSurfaceBrush}" BorderBrush="{ThemeResource JupiterSeparatorBrush}" BorderThickness="1,0,0,0">
                        <StackPanel Padding="16" Spacing="16">
                            <TextBlock Text="Recording details" Style="{StaticResource JupiterPaneHeadingTextStyle}"/>
                            <local:SourceBadgesControl x:Name="ImportSourceInfo"/>
                            <TextBlock x:Name="ImportCredits" Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap"/>
                            <TextBox x:Name="ArtistBox" Header="Artist"/>
                            <TextBox x:Name="DateBox" Header="Date" PlaceholderText="YYYY-MM-DD"/>
                            <TextBox x:Name="VenueBox" Header="Venue" TextWrapping="Wrap"/>
                            <TextBlock x:Name="WarningsText" Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap"/>
                            <CheckBox x:Name="ReviewedBox"><TextBlock Text="I reviewed the track order and titles" TextWrapping="Wrap"/></CheckBox>
                            <CheckBox x:Name="CopyAudioBox" IsChecked="True"><TextBlock Text="Copy compressed audio unchanged" TextWrapping="Wrap"/></CheckBox>
                            <TextBlock Text="With this unchecked, lossless 16-bit or 24-bit audio is encoded as FLAC at its original rate and depth. Formats must match. No resampling, gap insertion, trimming or crossfading. Sets are included in chapter names." Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap"/>
                            <Button x:Name="CreateButton" Content="Create MKA…" Style="{StaticResource AccentButtonStyle}" Click="OnCreate" IsEnabled="False"/>
                            <Expander Header="Original show notes"><ScrollViewer MaxHeight="320"><TextBlock x:Name="NotesText" Style="{StaticResource JupiterMonoTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></ScrollViewer></Expander>
                            <Expander Header="Offline show reference"><ScrollViewer MaxHeight="400"><TextBlock x:Name="ReferenceText" Style="{StaticResource JupiterBodyTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></ScrollViewer></Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Grid x:Name="JobPage" Grid.Row="1" Padding="24" RowSpacing="16" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="4"><TextBlock x:Name="JobState" Text="No job running" Style="{StaticResource JupiterSectionHeadingTextStyle}"/><TextBlock x:Name="JobPhase" Style="{StaticResource JupiterBodyTextStyle}" TextWrapping="Wrap"/></StackPanel>
                    <ProgressBar x:Name="JobProgress" Grid.Row="1" IsIndeterminate="True" Visibility="Collapsed"/>
                    <TextBox x:Name="JobOutput" Grid.Row="2" Header="Output" IsReadOnly="True" TextWrapping="Wrap"/>
                    <TextBox x:Name="JobLog" Grid.Row="3" Header="Activity" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"/>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8"><Button x:Name="CancelButton" Content="Cancel job" Click="OnCancel" IsEnabled="False"/><Button x:Name="UseOutputButton" Content="Open result" Click="OnUseOutput" IsEnabled="False"/></StackPanel>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
