<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Jupiter.ShowPlayer.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:jupiter="using:Jupiter.UI"
    Title="Settings - Gratitude">

    <!-- Standard section 11: one scrolling column, changes apply at once. -->
    <ScrollViewer x:Name="Root" Background="{ThemeResource JupiterWindowBrush}">
        <StackPanel Padding="24" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource JupiterPageHeadingTextStyle}" />

            <TextBlock Text="Appearance" Style="{StaticResource JupiterSectionHeadingTextStyle}" Margin="0,24,0,12" />
            <StackPanel Spacing="16">
                <jupiter:ThemeSetting x:Name="ThemeControl" />
                <jupiter:AccentColorSetting x:Name="AccentControl" />
            </StackPanel>

            <TextBlock Text="Library" Style="{StaticResource JupiterSectionHeadingTextStyle}" Margin="0,32,0,12" />
            <StackPanel Spacing="4">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox" Header="Shows folder" IsReadOnly="True" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="OnBrowse" />
                </Grid>
                <TextBlock x:Name="FolderCaption" Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap"
                           Text="The Shows pane lists the .mka files in this folder." />
                <HyperlinkButton x:Name="ResetFolderButton" Content="Use the folder of the last show" Click="OnResetFolder" />
            </StackPanel>

            <TextBlock Text="Playback" Style="{StaticResource JupiterSectionHeadingTextStyle}" Margin="0,32,0,12" />
            <StackPanel Spacing="4">
                <ComboBox x:Name="SkipBox" Header="Skip back and forward by" MinWidth="160" SelectionChanged="OnSkipChanged" />
                <TextBlock Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap"
                           Text="Used by the Back and Forward buttons and by Ctrl+Left and Ctrl+Right." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
